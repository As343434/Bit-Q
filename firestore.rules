rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if isSignedIn() && resource.data.google_uid == request.auth.uid;
      allow create, update: if isVerified() && isValidId(userId) && request.auth.uid == userId &&
                            request.resource.data.google_uid == request.auth.uid;
    }

    match /restaurants/{restaurantId} {
      allow get, list: if isSignedIn() && resource.data.name is string;
      allow create, update: if isVerified() && isValidId(restaurantId) &&
                            request.resource.data.owner_uid == request.auth.uid;
    }

    match /restaurant_categories/{categoryId} {
      allow get, list: if isSignedIn() && resource.data.name is string;
      allow create, update, delete: if isVerified() && isValidId(categoryId);
    }

    match /menu_items/{itemId} {
      allow get, list: if isSignedIn() && resource.data.name is string;
      allow create, update: if isVerified() && isValidId(itemId) &&
                            request.resource.data.owner_uid == request.auth.uid;
      allow delete: if isVerified() && isValidId(itemId) &&
                    resource.data.owner_uid == request.auth.uid;
    }

    match /coupons/{couponId} {
      allow get, list: if isSignedIn() && resource.data.code is string;
      allow create, update, delete: if isVerified() && isValidId(couponId);
    }

    match /orders/{orderId} {
      allow get, list: if isSignedIn() && resource.data.customer_uid is string;
      allow create: if isVerified() && isValidId(orderId) &&
                    request.resource.data.customer_uid == request.auth.uid;
      allow update: if isVerified() && isValidId(orderId) &&
                    resource.data.status != 'DELIVERED' &&
                    resource.data.status != 'CANCELLED';
    }

    match /support_tickets/{ticketId} {
      allow get, list: if isSignedIn() && resource.data.user_uid == request.auth.uid;
      allow create, update: if isVerified() && isValidId(ticketId) &&
                            request.resource.data.user_uid == request.auth.uid;
    }
  }
}
