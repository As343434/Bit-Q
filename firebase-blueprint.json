{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile for Customer, Restaurant Partner, or Delivery Partner.",
      "type": "object",
      "properties": {
        "google_uid": {
          "type": "string",
          "description": "Unique Google Authentication UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Full display name",
          "minLength": 1,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified Google account email address",
          "minLength": 3,
          "maxLength": 150
        },
        "profile_image": {
          "type": "string",
          "description": "Profile photo URL from Google",
          "maxLength": 500
        },
        "location": {
          "type": "string",
          "description": "Selected city or delivery area",
          "minLength": 1,
          "maxLength": 150
        },
        "lat": {
          "type": "number",
          "description": "Latitude coordinate"
        },
        "lng": {
          "type": "number",
          "description": "Longitude coordinate"
        },
        "place_id": {
          "type": "string",
          "description": "Location Place ID",
          "maxLength": 128
        },
        "role": {
          "type": "string",
          "enum": ["customer", "restaurant_partner", "delivery_partner"],
          "description": "Assigned role in the Bit'Q platform"
        },
        "delivery_preferences": {
          "type": "string",
          "description": "Optional customer delivery notes or instructions",
          "maxLength": 200
        },
        "dietary_preferences": {
          "type": "string",
          "description": "Optional customer dietary preferences",
          "maxLength": 100
        },
        "is_online": {
          "type": "boolean",
          "description": "Online/Offline availability status for Delivery Partners"
        },
        "delivery_range_km": {
          "type": "number",
          "description": "Configured delivery range in kilometers for Delivery Partners"
        },
        "restaurant_id": {
          "type": "string",
          "description": "Associated restaurant document ID for Restaurant Partners",
          "maxLength": 128
        },
        "total_rides": {
          "type": "number",
          "description": "Total courier rides count"
        },
        "orders_delivered": {
          "type": "number",
          "description": "Completed courier deliveries count"
        },
        "cancelled_deliveries": {
          "type": "number",
          "description": "Cancelled courier deliveries count"
        },
        "points": {
          "type": "number",
          "description": "Courier loyalty points"
        },
        "courier_rating": {
          "type": "number",
          "description": "Average courier rating"
        },
        "acceptance_rate": {
          "type": "number",
          "description": "Courier acceptance rate percentage"
        },
        "current_streak_days": {
          "type": "number",
          "description": "Courier active streak in days"
        },
        "total_earnings": {
          "type": "number",
          "description": "Courier total earnings"
        },
        "current_lat": {
          "type": "number",
          "description": "Courier live latitude"
        },
        "current_lng": {
          "type": "number",
          "description": "Courier live longitude"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "Account creation server timestamp"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "Last profile update server timestamp"
        }
      },
      "required": ["google_uid", "name", "email", "profile_image", "location", "role", "created_at", "updated_at"]
    },
    "Restaurant": {
      "title": "Restaurant",
      "description": "Restaurant storefront managed by a Restaurant Partner.",
      "type": "object",
      "properties": {
        "owner_uid": {
          "type": "string",
          "description": "UID of the Restaurant Partner owner",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Restaurant brand name",
          "minLength": 1,
          "maxLength": 120
        },
        "owner_name": {
          "type": "string",
          "description": "Name of the restaurant proprietor",
          "minLength": 1,
          "maxLength": 100
        },
        "contact_phone": {
          "type": "string",
          "description": "Business contact number",
          "minLength": 5,
          "maxLength": 30
        },
        "location": {
          "type": "string",
          "description": "Neighborhood and city address",
          "minLength": 1,
          "maxLength": 150
        },
        "lat": {
          "type": "number",
          "description": "Restaurant latitude"
        },
        "lng": {
          "type": "number",
          "description": "Restaurant longitude"
        },
        "cuisine": {
          "type": "string",
          "description": "Primary cuisine specialty",
          "minLength": 1,
          "maxLength": 80
        },
        "operating_hours": {
          "type": "string",
          "description": "Daily operating hours schedule",
          "minLength": 1,
          "maxLength": 80
        },
        "rating": {
          "type": "number",
          "description": "Average guest rating (1.0 to 5.0)"
        },
        "rating_count": {
          "type": "number",
          "description": "Total number of guest ratings"
        },
        "delivery_time": {
          "type": "string",
          "description": "Estimated delivery window",
          "minLength": 1,
          "maxLength": 40
        },
        "distance": {
          "type": "string",
          "description": "Approximate distance",
          "minLength": 1,
          "maxLength": 30
        },
        "price_indicator": {
          "type": "string",
          "description": "Price tier indicator",
          "minLength": 1,
          "maxLength": 10
        },
        "offer_text": {
          "type": "string",
          "description": "Featured promotional offer text",
          "maxLength": 100
        },
        "image_url": {
          "type": "string",
          "description": "Hero photograph URL",
          "minLength": 1,
          "maxLength": 500
        },
        "is_open": {
          "type": "boolean",
          "description": "Kitchen OPEN/CLOSED status"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp"
        }
      },
      "required": ["owner_uid", "name", "owner_name", "contact_phone", "location", "cuisine", "operating_hours", "rating", "delivery_time", "distance", "price_indicator", "offer_text", "image_url", "is_open", "created_at", "updated_at"]
    },
    "RestaurantCategory": {
      "title": "RestaurantCategory",
      "description": "Custom food category created by a Restaurant Partner.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "restaurant_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "owner_uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "display_order": {
          "type": "number"
        },
        "active": {
          "type": "boolean"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["restaurant_id", "owner_uid", "name", "display_order", "active", "created_at", "updated_at"]
    },
    "MenuItem": {
      "title": "MenuItem",
      "description": "Individual culinary dish belonging to a Restaurant.",
      "type": "object",
      "properties": {
        "restaurant_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "owner_uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "category_id": {
          "type": "string",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "price": {
          "type": "number"
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "image_url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "is_available": {
          "type": "boolean"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["restaurant_id", "owner_uid", "name", "description", "price", "category", "image_url", "is_available", "created_at", "updated_at"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Promotional discount coupon managed by a Restaurant Partner.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "code": {
          "type": "string",
          "minLength": 2,
          "maxLength": 30
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "discount_type": {
          "type": "string",
          "enum": ["PERCENTAGE", "FLAT"]
        },
        "discount_value": {
          "type": "number"
        },
        "maximum_discount": {
          "type": "number"
        },
        "minimum_order_value": {
          "type": "number"
        },
        "start_date": {
          "type": "string",
          "maxLength": 30
        },
        "expiry_date": {
          "type": "string",
          "maxLength": 30
        },
        "usage_limit": {
          "type": "number"
        },
        "used_count": {
          "type": "number"
        },
        "per_user_limit": {
          "type": "number"
        },
        "active": {
          "type": "boolean"
        },
        "restaurant_id": {
          "type": "string",
          "maxLength": 128
        },
        "owner_uid": {
          "type": "string",
          "maxLength": 128
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["code", "description", "discount_type", "discount_value", "maximum_discount", "minimum_order_value", "start_date", "expiry_date", "usage_limit", "used_count", "per_user_limit", "active", "restaurant_id", "owner_uid", "created_at", "updated_at"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer food delivery order with live status timeline and courier coordinates.",
      "type": "object",
      "properties": {
        "customer_uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "customer_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "delivery_address": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "delivery_lat": {
          "type": "number"
        },
        "delivery_lng": {
          "type": "number"
        },
        "restaurant_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "restaurant_owner_uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "restaurant_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "restaurant_location": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "restaurant_lat": {
          "type": "number"
        },
        "restaurant_lng": {
          "type": "number"
        },
        "delivery_partner_uid": {
          "type": "string",
          "maxLength": 128
        },
        "delivery_partner_name": {
          "type": "string",
          "maxLength": 100
        },
        "delivery_partner_rating": {
          "type": "number"
        },
        "courier_lat": {
          "type": "number"
        },
        "courier_lng": {
          "type": "number"
        },
        "items_summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "item_count": {
          "type": "number"
        },
        "subtotal": {
          "type": "number"
        },
        "delivery_fee": {
          "type": "number"
        },
        "discount": {
          "type": "number"
        },
        "coupon_code": {
          "type": "string",
          "maxLength": 30
        },
        "taxes": {
          "type": "number"
        },
        "total": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": [
            "ORDER_PLACED",
            "RESTAURANT_ACCEPTED",
            "FOOD_PREPARING",
            "READY_FOR_PICKUP",
            "COURIER_ACCEPTED",
            "GOING_TO_RESTAURANT",
            "ARRIVED_AT_RESTAURANT",
            "OUT_FOR_DELIVERY",
            "ARRIVED_AT_CUSTOMER",
            "DELIVERED",
            "CANCELLED"
          ]
        },
        "estimated_arrival": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "distance_km": {
          "type": "number"
        },
        "accepted_at": {
          "type": "string",
          "maxLength": 60
        },
        "arrived_at_restaurant_at": {
          "type": "string",
          "maxLength": 60
        },
        "picked_up_at": {
          "type": "string",
          "maxLength": 60
        },
        "arrived_at_customer_at": {
          "type": "string",
          "maxLength": 60
        },
        "delivered_at": {
          "type": "string",
          "maxLength": 60
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["customer_uid", "customer_name", "delivery_address", "restaurant_id", "restaurant_owner_uid", "restaurant_name", "restaurant_location", "delivery_partner_uid", "delivery_partner_name", "items_summary", "item_count", "subtotal", "delivery_fee", "discount", "taxes", "total", "status", "estimated_arrival", "distance_km", "created_at", "updated_at"]
    },
    "SupportTicket": {
      "title": "SupportTicket",
      "description": "Customer help desk ticket.",
      "type": "object",
      "properties": {
        "user_uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "category": {
          "type": "string",
          "enum": ["Order issue", "Missing item", "Late delivery", "Refund/payment issue", "Restaurant issue", "Delivery partner issue", "General support"]
        },
        "order_id": {
          "type": "string",
          "maxLength": 128
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "status": {
          "type": "string",
          "enum": ["OPEN", "IN_PROGRESS", "RESOLVED"]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["user_uid", "category", "order_id", "subject", "message", "status", "created_at", "updated_at"]
    },
    "StoreRating": {
      "title": "StoreRating",
      "description": "Customer rating and review for a restaurant and courier.",
      "type": "object",
      "properties": {
        "order_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "restaurant_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "customer_uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "customer_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "rating": {
          "type": "number"
        },
        "courier_rating": {
          "type": "number"
        },
        "comment": {
          "type": "string",
          "maxLength": 500
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["order_id", "restaurant_id", "customer_uid", "customer_name", "rating", "comment", "created_at"]
    },
    "OrderChatMessage": {
      "title": "OrderChatMessage",
      "description": "Real-time order chat message between Customer, Restaurant Partner, and Delivery Partner.",
      "type": "object",
      "properties": {
        "order_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sender_uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sender_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "sender_role": {
          "type": "string",
          "enum": ["customer", "restaurant_partner", "delivery_partner"]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["order_id", "sender_uid", "sender_name", "sender_role", "text", "created_at"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles isolated by owner UID"
    },
    "/restaurants/{restaurantId}": {
      "schema": { "$ref": "#/entities/Restaurant" },
      "description": "Restaurant storefronts managed by restaurant partners"
    },
    "/restaurant_categories/{categoryId}": {
      "schema": { "$ref": "#/entities/RestaurantCategory" },
      "description": "Custom food categories managed by restaurant partners"
    },
    "/menu_items/{itemId}": {
      "schema": { "$ref": "#/entities/MenuItem" },
      "description": "Menu dishes managed by restaurant partners"
    },
    "/coupons/{couponId}": {
      "schema": { "$ref": "#/entities/Coupon" },
      "description": "Promotional discount coupons managed by restaurant partners"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Orders shared across Customer, Restaurant, and Courier"
    },
    "/support_tickets/{ticketId}": {
      "schema": { "$ref": "#/entities/SupportTicket" },
      "description": "Customer help desk tickets"
    },
    "/store_ratings/{ratingId}": {
      "schema": { "$ref": "#/entities/StoreRating" },
      "description": "Store and courier ratings submitted by customers"
    },
    "/order_messages/{messageId}": {
      "schema": { "$ref": "#/entities/OrderChatMessage" },
      "description": "Real-time order chat messages"
    }
  }
}
